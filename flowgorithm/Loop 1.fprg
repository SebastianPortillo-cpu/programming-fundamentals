<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Loop 1"/>
        <attribute name="authors" value="Lab Analisis Datos"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-26 03:45:27 p.&#8239;m."/>
        <attribute name="created" value="TGFiIEFuYWxpc2lzIERhdG9zO0VRVUlQTy0yMDU7MjAyNi0xMC0yNjswMjoxNzozMSBwLuKAr20uOzExOTk3"/>
        <attribute name="edited" value="TGFiIEFuYWxpc2lzIERhdG9zO0VRVUlQTy0yMDU7MjAyNi0xMC0yNjswMzo0NToyNyBwLuKAr20uOzI7MTIxMTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Die1, Die2, i, par, impar, igual" type="Integer" array="False" size=""/>
            <assign variable="par" expression="0"/>
            <assign variable="impar" expression="0"/>
            <assign variable="igual" expression="0"/>
            <declare name="key" type="String" array="False" size=""/>
            <for variable="i" start="1" end="10" direction="inc" step="1">
                <output expression="&quot;Press any key to roll dice: &quot;" newline="True"/>
                <input variable="key"/>
                <output expression="&quot;Roll # &quot; &amp; i" newline="True"/>
                <assign variable="Die1" expression="Random (6)+1"/>
                <assign variable="Die2" expression="Random (6)+1"/>
                <output expression="&quot;Dice 1: &quot; &amp; Die1" newline="True"/>
                <output expression="&quot;Dice 2: &quot; &amp; Die2" newline="True"/>
                <declare name="add" type="Integer" array="False" size=""/>
                <assign variable="add" expression="Die1+Die2"/>
                <if expression="add mod 2 = 0">
                    <then>
                        <output expression="&quot;The sum of the throw is even: &quot; &amp; add" newline="True"/>
                        <assign variable="par" expression="par+1"/>
                    </then>
                    <else>
                        <if expression="add %2 != 0">
                            <then>
                                <output expression="&quot;The sum of the two dice is odd: &quot; &amp; add" newline="True"/>
                                <assign variable="impar" expression="impar+1"/>
                            </then>
                            <else>
                                <if expression="Die1 = Die2">
                                    <then>
                                        <output expression="&quot;The dice are the same&quot;" newline="True"/>
                                        <assign variable="igual" expression="igual+1"/>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;Even: &quot; &amp; par &amp;ToChar (13)&amp;&#13;&#10;&quot;Odd: &quot;&amp; impar &amp;ToChar(13)&amp;&#13;&#10;&quot;Same: &quot;&amp; igual" newline="True"/>
        </body>
    </function>
</flowgorithm>
