Algoritmo Days_hours_minutes_and_seconds
	Definir dia,hor,min,seg Como Entero
	Escribir "Enter the days you want to convert them to hours, minutes and seconds "
	leer dia
	hor = dia*24
	min = hor*60
	seg = min*60
	Escribir dia " days are equivalent to " hor  " hours," min " minutes and " seg " seconds"
FinAlgoritmo
